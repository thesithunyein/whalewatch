# Birdeye API Key (get from https://docs.birdeye.so/)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# QuickNode Solana RPC URL (get free tier from https://www.quicknode.com/chains/sol)
QUICKNODE_RPC_URL=https://your-quicknode-url.solana-mainnet.quiknode.pro/your-key/

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram Bot Token (optional, for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (optional, for alerts)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
